{
  "name": "@me-palnadu/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Single source of truth for domain types, enums, validation schemas, error codes, and API contracts.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.5"
  }
}
