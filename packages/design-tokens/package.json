{
  "name": "@me-palnadu/design-tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Canonical colour, typography, spacing, radius, elevation, motion, breakpoint, and z-index tokens.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./src/theme.css"
  },
  "files": [
    "dist",
    "src/theme.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  }
}
