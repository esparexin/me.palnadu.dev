// Prisma schema for the portfolio API.
//
// SCOPE (Phase 6G): the Experience, Knowledge Hub, and media slices.
// Other collections in ARCHITECTURE.md section 7 arrive with their own vertical
// slice, never as an up-front guess at future models.
//
// SCHEMA MANAGEMENT: Prisma's MongoDB connector does not support `prisma migrate`
// (verified against Prisma 6.19.3). Schema changes are applied with `prisma db push`
// as an explicit, reviewed step. That is NOT equivalent to a migration and does NOT
// give a rollback path for data. See docs/adr/0006 and scripts/check-schema.mjs.
//
// CANONICAL VALUES: enum-like fields are `String`, not Prisma `enum` blocks, because
// the allowed values live once in @me-palnadu/contracts (SSOT_POLICY.md section 1).
// MongoDB therefore does not enforce these value sets on its own; the API boundary
// does, using the contract schemas.

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// A career timeline entry.
///
/// Ordering mirrors the canonical comparator `compareExperience` in
/// @me-palnadu/shared (newest first, current role first, then sortIndex, then id).
/// The index below supports exactly that order; an integration test asserts the
/// database order and the comparator cannot diverge.
model Experience {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  slug        String    @unique
  org         String
  title       String
  location    String?
  /// ISO calendar month, `YYYY-MM`. Month precision is deliberate: a day-level
  /// employment date is a professional claim we cannot verify (AGENTS.md 4).
  startDate   String
  endDate     String?
  current     Boolean   @default(false)
  /// Canonical values in @me-palnadu/contracts (EXPERIENCE_KINDS).
  kind        String
  summary     String
  highlights  String[]  @default([])
  tech        String[]  @default([])
  sortIndex   Int       @default(0)
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Public reads filter on `published` and order by the comparator's key order.
  // The unique index on `slug` is created by the field-level `@unique`.
  @@index([published, startDate, current, sortIndex])
}

/// An administrator, keyed on the immutable numeric GitHub id.
///
/// The database is the authority on who may write. A JWT claim is advisory: the
/// guard re-reads this record on every protected request, so revoking an
/// administrator takes effect immediately rather than at token expiry
/// (SECURITY.md section 4).
/// The single administrator (ADR-0009).
///
/// Identity is an email address and a scrypt password hash. `githubId` and `login`
/// were removed when authentication moved from GitHub OAuth to email and password;
/// see docs/exceptions.md for the reviewed destructive-change exception.
model AdminUser {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  /// Normalized to lower case with surrounding whitespace stripped, so the same
  /// address cannot exist twice under different spellings.
  email    String @unique
  /// Encoded scrypt digest: algorithm, cost parameters, salt and derived key.
  /// A plaintext password is never stored, logged, or returned (SECURITY.md 4).
  passwordHash String
  /// Canonical values in @me-palnadu/contracts (ROLES).
  role        String   @default("owner")
  displayName String?
  /// Incremented to revoke every session an administrator holds. A password change
  /// increments it, so a credential change invalidates every existing session.
  tokenVersion Int      @default(0)
  /// Set to false to block sign-in and invalidate existing sessions without deleting
  /// the record, which is how an emergency lockout is expressed.
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastLoginAt  DateTime?
  /// Consecutive failed sign-ins, reset on success. Recorded, not used to lock.
  failedLoginCount Int @default(0)

  sessions AdminSession[]
}

/// One administrator session.
///
/// The session id in the token (`sid`) must resolve to a live row, which is what
/// makes per-session revocation and sign-out-everywhere possible without waiting
/// for a token to expire.
model AdminSession {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  /// Matches the `sid` claim; stored so a token's session can be found directly.
  sessionId  String    @unique
  userId     String    @db.ObjectId
  /// The token version this session was issued under. A user-level increment
  /// invalidates every session without touching the rows.
  tokenVersion Int
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user       AdminUser @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

/// Append-only record of every administrative write (SECURITY.md section 4).
model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  /// The `sub` of the administrator who performed the action.
  actorId    String   @db.ObjectId
  action     String
  entityType String
  entityId   String
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

/// Knowledge Hub article (ADR-0010).
///
/// `body` is Markdown source, rendered by the restricted parser in
/// @me-palnadu/shared. It is never stored as HTML: an HTML column would make every
/// renderer a trust boundary.
model Article {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  slug        String    @unique
  /// Canonical values in @me-palnadu/contracts (ARTICLE_KINDS).
  kind        String
  title       String
  excerpt     String
  body        String
  tags        String[]  @default([])
  /// Canonical values in @me-palnadu/contracts (DIFFICULTIES); required for interviews.
  difficulty  String?
  /// Canonical values in @me-palnadu/contracts (CONTENT_STATUSES).
  status      String    @default("draft")
  /// Publication is an instant, stamped by the API. Cleared when the article
  /// leaves the published state so a stale date cannot look live.
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt])
  @@index([kind, status])
}

/// Metadata for an asset uploaded directly to Cloudinary (ADR-0010 §4).
///
/// No bytes pass through the API. This row is the register of what was uploaded,
/// so the library can list and delete assets without querying the provider for
/// every page render.
model MediaAsset {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  publicId         String   @unique
  secureUrl        String
  format           String
  resourceType     String
  bytes            Int
  width            Int?
  height           Int?
  originalFilename String
  alt              String   @default("")
  createdAt        DateTime @default(now())

  @@index([createdAt])
}
