{
  "name": "@me-palnadu/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NestJS REST API: the only authority for validation, authorization, and persistence.",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "dev": "node --watch dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test *.ts",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:push": "prisma db push --skip-generate",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@me-palnadu/contracts": "workspace:*",
    "@me-palnadu/shared": "workspace:*",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/throttler": "6.7.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7",
    "@prisma/client": "6.19.3",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "prisma": "6.19.3",
    "@types/express": "5.0.6",
    "@nestjs/testing": "12.1.3",
    "supertest": "7.3.1",
    "@types/supertest": "7.2.1"
  }
}
