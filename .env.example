# Keys only. Never a value (SECURITY.md section 7).
# Copy to .env locally; production values live in Vercel, Render, Atlas, and
# GitHub Actions environment stores.

# --- apps/api (Render) ---------------------------------------------------------
NODE_ENV=development
PORT=4000
# MongoDB Atlas connection string. Absent locally is fine: readiness reports 503.
DATABASE_URL=
# Must be byte-identical to apps/admin AUTH_SECRET (>= 32 characters).
AUTH_SECRET=
AUTH_ISSUER=me-palnadu-admin
AUTH_AUDIENCE=me-palnadu-api
# Exact origins only. A wildcard is rejected at startup.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
LOG_LEVEL=info

# --- apps/admin (Vercel) -------------------------------------------------------
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_TRUST_HOST=false
# Server-side only. Never exposed to the browser.
ADMIN_API_URL=http://localhost:4000
ADMIN_ALLOWED_ORIGINS=http://localhost:3001
NEXT_PUBLIC_ADMIN_SITE_URL=http://localhost:3001

# --- apps/web (Vercel) ---------------------------------------------------------
# NEXT_PUBLIC_ values are public by definition. Only public data belongs here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_GA_ID=

# --- GitHub Actions (environment secrets, not repository secrets) ---------------
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID_WEB=
VERCEL_PROJECT_ID_ADMIN=
RENDER_API_KEY=
ATLAS_PRODUCTION_URI=
ATLAS_STAGING_URI=
