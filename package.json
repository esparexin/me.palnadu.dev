{
  "name": "me-palnadu-dev",
  "version": "0.0.0",
  "private": true,
  "description": "Personal professional portfolio: public site, admin, API, and shared contracts.",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check:structure": "node scripts/validate-structure.mjs",
    "check:docs": "node scripts/validate-docs.mjs",
    "check:secrets": "node scripts/scan-secrets.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:contracts": "node scripts/validate-contracts.mjs",
    "check:ci": "node scripts/ci-integrity.mjs",
    "verify": "pnpm run check:structure && pnpm run check:docs && pnpm run check:secrets && pnpm run check:workflows && pnpm run test:gates && pnpm run format:check && pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build && pnpm run check:boundaries && pnpm run check:contracts && pnpm run check:ci",
    "check:workflows": "node scripts/check-workflows.mjs",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "test:a11y": "playwright test --config tests/e2e/playwright.config.ts tests/e2e/a11y",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,json,css,md}\"",
    "test:gates": "vitest run tests/gates"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jscpd": "5.4.1",
    "knip": "6.42.0",
    "prettier": "3.9.10",
    "turbo": "2.11.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "@playwright/test": "1.64.1",
    "@axe-core/playwright": "4.14.0"
  }
}
